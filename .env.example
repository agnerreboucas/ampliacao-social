# Modelo das variáveis de ambiente.
#
# Copie para `.env` e preencha. O `.env` está no .gitignore e nunca deve entrar
# no repositório — em servidor, estes valores são configurados no painel do
# provedor, não em arquivo.

# --- Obrigatórias em produção ------------------------------------------------

# Postgres. Sem ela a plataforma sobe em modo demonstração, com dados semeados.
# Serviço gerenciado exige TLS; Postgres na mesma máquina normalmente não:
#   gerenciado: postgresql://usuario:senha@host/banco?sslmode=require
#   local:      postgresql://postgres@127.0.0.1:5432/social_app?sslmode=disable
DATABASE_URL=

# Chave que sela o cookie de sessão. Mínimo de 32 caracteres.
# Gere uma com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Trocar esta chave desconecta todo mundo — as sessões seladas com a anterior
# deixam de valer. Isso é útil de propósito no dia em que for preciso encerrar
# todas as sessões de uma vez.
SESSION_SECRET=

# --- Opcionais ----------------------------------------------------------------

# Porta onde escutar. Padrão 3000.
PORT=3000

# Conexão real com Instagram e Facebook. Depende da revisão do aplicativo pela
# Meta; sem estas variáveis a tela de conexão avisa que não está configurada.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Cifra os tokens das redes guardados no banco. Obrigatória se usar o OAuth
# acima — sem ela, os tokens ficariam legíveis para quem lesse o banco.
CREDENCIAIS_CHAVE=

# Números de mídia paga pelo Windsor.ai.
WINDSOR_API_KEY=

# --- Só para conferir a build na própria máquina ------------------------------

# O cookie de sessão exige HTTPS na build de produção. Em servidor exposto isso
# não se desliga; esta variável existe apenas para rodar a build localmente,
# onde não há certificado, e imprime aviso no log.
# SESSAO_SEM_TLS=sim
