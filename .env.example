# Integração com a Meta (Instagram e Facebook)
#
# Sem estas variáveis a plataforma funciona em modo demonstração, com contas de
# exemplo. Ao preenchê-las, o botão da tela de contas passa a abrir a
# autorização oficial da Meta.
#
# Passo a passo de onde obter cada valor: docs/integracao-meta.md

# Painel do app em developers.facebook.com → Configurações → Básico
META_APP_ID=
META_APP_SECRET=

# URL de retorno. Precisa ser idêntica à cadastrada no app da Meta, em
# Login do Facebook → Configurações → URIs de redirecionamento do OAuth válidos.
# Em desenvolvimento: http://localhost:5173/oauth/retorno
META_REDIRECT_URI=https://seu-dominio.com.br/oauth/retorno

# Opcional: fixa a versão da Graph API (padrão v21.0).
# META_GRAPH_VERSION=v21.0

# Chave para cifrar os tokens das redes em repouso.
# Gere com:  openssl rand -base64 32
# Trocar esta chave invalida os tokens guardados e exige reconectar as contas.
SOCIAL_CRYPTO_KEY=

# --- Windsor.ai (caminho alternativo para dados reais) ---------------------
#
# Agregador com 350+ conectores. O cliente conecta as contas no painel do
# Windsor e a plataforma lê tudo com esta chave — sem depender da revisão do
# aplicativo pela Meta. Passo a passo: docs/integracao-windsor.md
WINDSOR_API_KEY=

# Opcional: aponta para um proxy interno ou ambiente de testes.
# WINDSOR_BASE_URL=https://connectors.windsor.ai

# --- Banco de dados (Neon, Supabase ou qualquer Postgres) ------------------
#
# Sem esta variável, a plataforma guarda tudo em dados/plataforma.json, que vai
# para o Git. Com ela, passa a gravar no banco — e o que é digitado sobrevive a
# reinício, deploy e troca de máquina, sem passo manual.
#
# No Neon: painel do projeto → Connection string → Node.js.
# ATENÇÃO: a string contém a senha. Ela vai no ambiente da hospedagem, nunca
# em arquivo commitado. Passo a passo: docs/banco-de-dados.md
DATABASE_URL=

# Opcional: limite de conexões simultâneas (padrão 5, folgado para o plano
# gratuito do Neon).
# DATABASE_POOL_MAX=5

# Opcional: aponta o arquivo JSON para outro lugar quando não se usa banco.
# SOCIAL_DADOS_ARQUIVO=dados/plataforma.json
